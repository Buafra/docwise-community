# DocWise Community configuration
# Copy this file to ".env" (same folder as app.py) and fill in what you use.
# The .env file is ignored by git - your keys never leave your machine.

# --- Azure Document Intelligence (optional, paid ~ $1.5 per 1000 pages) ---
# Strong Arabic print + handwriting. Used ONLY when local OCR confidence is low.
# Azure portal: Create resource -> "Document Intelligence" -> Keys and Endpoint.
# The free F0 tier includes 500 pages per month.
#AZURE_DI_ENDPOINT=https://your-resource-name.cognitiveservices.azure.com
#AZURE_DI_KEY=your-azure-key-here

# --- OpenAI (optional, paid) ---
# Enables OpenAI Vision OCR fallback, GPT answers, and OpenAI embeddings.
#OPENAI_API_KEY=sk-...

# --- Ollama (optional, free local AI - auto-detected when running) ---
#DOCWISE_OLLAMA_MODEL=            # force a vision model, e.g. gemma3:12b
#DOCWISE_OLLAMA_CHAT_MODEL=       # force the Ask answer model, e.g. qwen3.5:9b
#DOCWISE_OLLAMA=auto              # set to off to disable Ollama entirely

# --- Tuning (optional) ---
#DOCWISE_MAX_OCR_PDF_PAGES=20     # OCR at most this many pages per PDF
#DOCWISE_OCR_WORKERS=4            # parallel OCR threads
#DOCWISE_SKIP_DUPLICATES=1        # 0 to index identical files twice
#DOCWISE_PADDLE=auto              # off to disable optional PaddleOCR
